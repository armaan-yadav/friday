# Friday — copy to .env and fill in values.

# ─── STT ────────────────────────────────────────────────────────────────────
STT_PROVIDER=whisper                          # whisper | sarvam
STT_SAMPLE_RATE=16000
STT_LANGUAGE=en                               # whisper language code (currently English-only)

# Whisper (local)
STT_MODEL_SIZE=large-v3                       # tiny | base | small | medium | large | large-v3
STT_WHISPER_DEVICE=cuda                       # cuda | cpu
STT_COMPUTE_TYPE=float16                      # float16 | float32 | int8

# Sarvam (cloud) — same key works for STT + TTS
SARVAM_API_KEY=
STT_SARVAM_API_KEY=                           # optional override
STT_SARVAM_URL=https://api.sarvam.ai/speech-to-text
STT_SARVAM_MODEL=saarika:v2.5
STT_SARVAM_LANGUAGE=en-IN                     # BCP-47
STT_SARVAM_TIMEOUT=30

# Wake word + VAD — comma-separated; include common Whisper misrecognitions
STT_WAKE_WORDS=friday,hey friday,hi friday,hello friday,okay friday,ok friday,yo friday,fryday,fridey,fride,free day,frida,freeday,friyay
STT_WAKE_FUZZY_THRESHOLD=85               # 0-100; lower = more permissive
STT_WAKE_WORD_TIMEOUT=8.0
STT_CONVERSATION_TIMEOUT=25.0                # follow-up window after Friday's last reply
STT_SILENCE_THRESHOLD=0.01
STT_SILENCE_DURATION=1.5
STT_MIN_SPEECH_DURATION=0.5
STT_MIN_SPEECH_DURATION_IDLE=0.25         # shorter while idle so "Friday!" alone is kept
STT_BLOCK_SIZE=1600

# Semantic endpointing — wait longer when the user trails off on a "dangler"
# (preposition, conjunction, article…) so mid-sentence pauses don't fire a turn.
STT_DANGLER_GRACE_PERIOD=2.0                  # seconds to wait for a continuation
STT_MERGE_WINDOW=1.5                          # merge a follow-up arriving within this window
# STT_DANGLER_WORDS=and,or,but,...            # override the built-in list (comma-separated)

# ─── LLM (LM Studio) ───────────────────────────────────────────────────────
LLM_STUDIO_URL=http://192.168.1.5:1234/v1/chat/completions
LLM_MODEL=google/gemma-4-e4b
LLM_SYSTEM_PROMPT=You are a voice assistant named Friday.\n\nKeep responses short, natural, and conversational.\nNo markdown, no bullet points, no headers.\nRespond as you would speak out loud.
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=300
LLM_REQUEST_TIMEOUT=30

# ─── TTS ────────────────────────────────────────────────────────────────────
TTS_PROVIDER=kokoro                           # kokoro | sarvam

# Kokoro (local)
TTS_KOKORO_LANG=a                             # a (American) | b (British)
TTS_KOKORO_VOICE=af_heart
TTS_KOKORO_SAMPLE_RATE=24000

# Sarvam (cloud)
TTS_SARVAM_API_KEY=                           # optional override; inherits SARVAM_API_KEY
TTS_SARVAM_URL=https://api.sarvam.ai/text-to-speech
TTS_SARVAM_MODEL=bulbul:v2
TTS_SARVAM_SPEAKER=anushka                    # f: anushka, manisha, vidya, arya | m: abhilash, karun, hitesh
TTS_SARVAM_LANGUAGE=en-IN
TTS_SARVAM_SAMPLE_RATE=22050                  # 8000 | 16000 | 22050
TTS_SARVAM_PITCH=0.0
TTS_SARVAM_PACE=1.0
TTS_SARVAM_LOUDNESS=1.0
TTS_SARVAM_TIMEOUT=30

# Wake ack — short reply when the wake word fires alone (no follow-up query)
TTS_ACK_ENABLED=true
TTS_ACK_PHRASES=mm hmm,yes boss,yeah?,I'm listening

# Barge-in
TTS_BARGE_IN_THRESHOLD=0.02
TTS_BARGE_IN_CONFIRM_BLOCKS=3

# ─── Server ─────────────────────────────────────────────────────────────────
SERVER_PORT=5000
SERVER_OUTPUT_JSON=data/transcripts.json
SERVER_MUTE_FLAG_PATH=data/muted.flag

# ─── Web search (SearXNG + Jina Reader) ────────────────────────────────────
SEARCH_SEARXNG_URL=http://localhost:8888/search
SEARCH_JINA_URL=https://r.jina.ai/
SEARCH_NUM_RESULTS=4
SEARCH_FETCH_FULL_PAGES=2
SEARCH_MAX_PAGE_CHARS=1500
SEARCH_TIMEOUT=8
SEARCH_JINA_TIMEOUT=12

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
